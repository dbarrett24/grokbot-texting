{
  "name": "grokbot-texting",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node scripts/check-example-numbers.mjs && node scripts/check-wrangler-assets.mjs && node scripts/mutation-check.mjs --patterns && node scripts/harbor-tokens.mjs --check && vitest run",
    "check": "node scripts/check-wrangler-assets.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "mutation": "bash scripts/mutation-check.sh",
    "lint": "oxlint --type-aware .",
    "lint:ratchet": "node scripts/ci/lint-ratchet.mjs",
    "typecheck:strict-next": "node scripts/ci/tsc-ratchet.mjs tsc-strict-next-baseline.json tsconfig.strict-next.json tsconfig.node.strict-next.json",
    "typecheck:scripts": "node scripts/ci/tsc-ratchet.mjs tsc-scripts-baseline.json tsconfig.scripts.json",
    "verify": "node scripts/verify.mjs",
    "check:env-docs": "node scripts/ci/check-env-docs.mjs --strict",
    "check:ancestors": "node scripts/ci/check-ancestors.mjs",
    "check:pii": "node scripts/ci/pii-scan.mjs",
    "check:numbers": "node scripts/check-example-numbers.mjs",
    "harbor:tokens": "node scripts/harbor-tokens.mjs",
    "walk": "node scripts/walk.mjs",
    "walk:config": "node scripts/walk-config.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@evolve.ui/theme-system": "1.2.0",
    "@types/node": "^22.20.5",
    "@vitest/runner": "^4.1.12",
    "@vitest/snapshot": "^4.1.12",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.1"
  }
}
